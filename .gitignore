# =================================================================
# Học Lái Xe Ba Lan - .gitignore
# =================================================================

# OS files
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
ehthumbs_vista.db
*.lnk

# Windows
$RECYCLE.BIN/
System Volume Information/

# macOS
.AppleDouble
.LSOverride
._*

# Linux
*~
.fuse_hidden*
.Trash-*

# =================================================================
# IDE / Editor
# =================================================================
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.cursor/
.cursorignore
.cursorignore-e

# VS Code
.history/

# JetBrains (WebStorm, IntelliJ)
*.iml
*.iws
*.ipr
out/

# =================================================================
# Node / npm (if added later)
# =================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml
.npm/
.eslintcache
.stylelintcache

# =================================================================
# Build / Output
# =================================================================
dist/
build/
out/
*.min.js
*.min.css
.cache/
.parcel-cache/
.next/
.nuxt/
.vite/

# =================================================================
# Environment / Secrets
# =================================================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
config.js
secrets.json

# =================================================================
# Logs
# =================================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# =================================================================
# Netlify
# =================================================================
.netlify/

# =================================================================
# Temporary files
# =================================================================
*.tmp
*.bak
*.swp
*.orig
*.rej
*.zip
*.tar.gz
*.rar
*.7z

# Local config / notes
*.local
TODO.md
NOTES.md
scratch.txt
